# Gabfix Portal — client environment
# Copy to .env and fill in values.

# Base URL of the shared Gabfix server API
VITE_API_BASE_URL=http://localhost:5000/api

# App identifier sent as the X-App-Id header (request logging + scoping)
VITE_APP_ID=portal

# Web Push: URL-safe base64 VAPID public key from the server (plan §F4.4).
# Set this to the key the server logs at startup with
#   VITE_VAPID_PUBLIC_KEY=<url-safe base64>
VITE_VAPID_PUBLIC_KEY=
