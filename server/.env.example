# Copy this file to server/.env and fill in real values.
# Only the DATABASE / API / AUTH / TZ groups are required to run Phase 0.
# Provider keys are validated lazily: the app boots with them empty and the
# affected channel is reported as disabled (see enhance.md, section 7).

# --- PostgreSQL (required) ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=gabfix

# --- API server (required) ---
PORT=5000
APP_BASE_URL=http://localhost:5000
TZ=Africa/Kampala

# --- Authentication (required from Phase 0.5) ---
JWT_SECRET=generate-a-long-random-string
JWT_TTL=12h
REFRESH_TTL=7d
# Flip to true once the login screen ships (Phase 0.10): every /api route
# except /api/health then demands a Bearer access token.
AUTH_ENFORCE=false

# --- Multi-app CORS (Phase 0c) ---
# The four Vercel app origins and local dev ports 5173–5179 are always allowed.
# Set to true only for throwaway testing (e.g. preview servers): every origin
# passes, which disables the browser same-origin protection for the API.
CORS_ALLOW_ALL=false

# --- Initial owner account (Phase 0.4) ---
# Password for the seeded owner employee (Gabriel N.). Change it after first login.
OWNER_PASSWORD=gabfix-owner

# --- Documents / PDF (Phase 2) ---
DOCUMENT_STORAGE_DIR=./storage/documents

# --- Web Push / VAPID (Phase 2c) ---
#
# VAPID keys let the service worker in every app receive cross-app push
# notifications (plan §F1/F2: all four apps, bell-only surface). Generate
# with: npx web-push generate-vapid-keys
# Then set VAPID_EMAIL to the mailto: address that signs the tokens.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@gabfix.local

# --- WhatsApp Cloud API (Phase 3) ---
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_JOB_DONE=
WHATSAPP_TEMPLATE_APPRECIATION=

# --- SMS fallback, Africa's Talking (Phase 3) ---
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# --- Email for document delivery (Phase 3) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- GPS beacon (Phase 4) ---
GPS_PING_INTERVAL_SECONDS=45
GPS_RETENTION_DAYS=90